[Unit]
Description=UxPlay Debug Service
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%u
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%u/bus
ExecStartPre=-/usr/bin/pkill -9 uxplay

# Run uxplay and dump all output to a log file
ExecStart=/bin/bash -c '/usr/bin/uxplay -avdec -vs ximagesink >> $HOME/uxplay-debug.log 2>&1'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
